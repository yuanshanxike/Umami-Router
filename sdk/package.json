{
  "name": "@umami_router/sdk",
  "version": "0.3.0",
  "description": "Umami analytics SDK with Core, Browser IIFE, Vue 3, and Next.js integrations",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./browser": "./dist/browser.global.js",
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs.d.ts",
      "import": "./dist/nextjs.mjs",
      "require": "./dist/nextjs.js"
    }
  },
  "scripts": {
    "lint": "bun run typecheck",
    "build": "bun run build:bun",
    "build:node": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "build:bun": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bunx tsup",
    "dev": "bun run dev:bun",
    "dev:node": "tsup --watch",
    "dev:bun": "bunx tsup --watch",
    "test": "bun test",
    "typecheck": "bun run typecheck:bun",
    "typecheck:node": "tsc --noEmit",
    "typecheck:bun": "bunx tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0"
  },
  "packageManager": "bun@1.3.9"
}
