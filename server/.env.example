# Server
PORT=3000

# Required: Umami upstream host (host:port), example: umami.example.com:3000 or Tailscale IP:3000
UMAMI_UPSTREAM_HOST=localhost:3000

# Recommended: comma-separated list of allowed Website IDs (or fallback single ID)
UMAMI_WEBSITE_IDS=
# UMAMI_WEBSITE_ID=

# Required for cross-origin browser requests (comma-separated origins; empty rejects cross-origin)
UMAMI_ALLOWED_ORIGINS=http://localhost:3001

# Optional proxy tuning
UMAMI_TIMEOUT_MS=5000
UMAMI_HEALTH_CACHE_TTL_MS=15000
UMAMI_RATE_LIMIT_WINDOW_MS=60000
UMAMI_RATE_LIMIT_MAX=100

# Optional upstream asset paths
UMAMI_SCRIPT_PATH=/script.js
UMAMI_RECORDER_PATH=/recorder.js
